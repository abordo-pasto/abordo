# Etapa 1: compilar con Maven
FROM maven:3.9-eclipse-temurin-17 AS compilacion
WORKDIR /app
COPY pom.xml .
RUN mvn -B -q dependency:go-offline
COPY src ./src
RUN mvn -B -q package -DskipTests

# Etapa 2: imagen liviana solo con el .jar
FROM eclipse-temurin:17-jre
WORKDIR /app
COPY --from=compilacion /app/target/abordo.jar abordo.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "abordo.jar"]
